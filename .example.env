# Application database connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=golang_practice
DB_USER=app_user
DB_PASSWORD=change-me
DB_SSL=disable

# JWT signing secret (replace with a long random value outside local development)
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL container's initial database and user
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=golang_practice
